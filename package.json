{
  "name": "alliance",
  "version": "1.0.0",
  "description": "multiplayer space shooter mini games",
  "private": true,
  "workspaces": [
    "shared",
    "frontend",
    "game-server"
  ],
  "scripts": {
    "build:shared": "npm --prefix shared run build",
    "dev:server": "npm run build:shared && npm --prefix game-server start",
    "dev:frontend": "npm run build:shared && npm --prefix frontend run dev:clean",
    "test": "npm --prefix game-server test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techsavagery/alliance.git"
  },
  "author": "Tech Savagery",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/techsavagery/alliance/issues"
  },
  "homepage": "https://github.com/techsavagery/alliance#readme"
}
