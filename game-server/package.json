{
  "private": true,
  "name": "alliance-game-server",
  "version": "1.0.0",
  "description": "Alliance multiplayer game server",
  "main": "lib/index.js",
  "scripts": {
    "build:shared": "npm --prefix ../shared run build",
    "start": "npm run build:shared && ts-node-dev --respawn --transpile-only src/index.ts",
    "loadtest": "colyseus-loadtest loadtest/example.ts --room game_room --numClients 2",
    "build": "npm run clean && tsc && node node_modules/copyfiles/copyfiles package.json ./lib && node node_modules/copyfiles/copyfiles development.env ./lib",
    "clean": "node node_modules/rimraf/bin lib",
    "test": "npm run build:shared && mocha --require ts-node/register test/**_test.ts --exit --timeout 15000"
  },
  "author": "Tech Savagery",
  "license": "ISC",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.8",
    "@colyseus/testing": "^0.17.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "copyfiles": "^2.4.1",
    "mocha": "^10.8.2",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@alliance/shared": "file:../shared",
    "@colyseus/monitor": "^0.17.7",
    "@colyseus/schema": "^4.0.8",
    "@colyseus/ws-transport": "^0.17.9",
    "colyseus": "^0.17.10",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}
