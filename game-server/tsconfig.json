{
  "compilerOptions": {
    "outDir": "lib",
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "allowJs": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@alliance/shared": ["../shared/src/index.ts"],
      "@alliance/shared/schema": ["../shared/src/schema/index.ts"],
      "@alliance/shared/games/skyRaid/schema": [
        "../shared/src/games/skyRaid/schema/index.ts"
      ]
    }
  },
  "include": ["src"]
}
